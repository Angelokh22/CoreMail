{
  "name": "coremail",
  "version": "2.2.2",
  "description": "CoreMail — Multi-account email client built with Electron & React",
  "main": "main/main.js",
  "author": "Angelo Khairallah <angelo@angelokhairallah.com>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "imapflow": "^1.0.162",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.13",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "bootstrap": "^5.3.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.angelo.coremail",
    "productName": "CoreMail",
    "publish": {
      "provider": "github",
      "owner": "Angelokh22",
      "repo": "CoreMail"
    },
    "protocols": [
      {
        "name": "CoreMail",
        "schemes": ["mailto"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "perMachine": true
    },
    "extraResources": [],
    "asar": true
  }
}
